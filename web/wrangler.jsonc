{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kronicle",
  // adapter-cloudflare writes the SvelteKit server bundle here at build time
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-09-06",
  // SvelteKit's server runtime relies on Node built-ins
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Non-secret: the deployed Worker API. Replace <account> after deploying worker/.
    "API_URL": "https://kronicle-api.<account>.workers.dev"
  },
  "routes": [
    { "pattern": "kronicle.spelltest.bidipeppercrap.com", "custom_domain": true }
  ]
  // API_TOKEN is a secret — set it with `wrangler secret put API_TOKEN` (must match worker/'s API_TOKEN).
  // Read server-side only via $env/dynamic/private; never shipped to the browser.
}
